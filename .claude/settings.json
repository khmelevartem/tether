{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/pre-git-checklist.sh"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/name-session.js"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/scripts/cleanup-worktrees.sh"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash -c 'COMMON_DIR=$(git rev-parse --git-common-dir 2>/dev/null) || exit 0; MAIN_ROOT=$(cd \"$COMMON_DIR/..\" && pwd); if [ ! -f local.properties ] && [ -f \"$MAIN_ROOT/local.properties\" ]; then cp \"$MAIN_ROOT/local.properties\" local.properties && echo \"copied local.properties from $MAIN_ROOT\"; fi'"
          }
        ]
      }
    ]
  }
}
