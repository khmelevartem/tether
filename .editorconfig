[*.{kt,kts}]

max_line_length = 120

# For function declarations
ktlint_standard_function-signature = disabled

# For parameter/argument lists
ktlint_standard_parameter-list-wrapping = disabled

# Composable functions naming
ktlint_function_naming_ignore_when_annotated_with = Composable

# Allows wildcard imports for Ktor packages and all its subpackages
ij_kotlin_packages_to_use_import_on_demand = io.ktor.**

# Line breaks
ktlint_standard_multiline-expression-wrapping = disabled
ktlint_standard_string-template-indent = disabled

compose_preview_public_check = false

# see docs/engineering/ui-style-guide.md
compose_allowed_composition_locals = LocalTetherColors,LocalTetherTypography,LocalTetherSpacing,LocalTetherShapes

# Generated sources (Compose resource accessors) use names ktlint's naming rules reject;
# the gradle filter excludes them from check but not from format, so disable the rules by path.
[**/build/generated/**/*.kt]
ktlint_standard_class-naming = disabled
ktlint_standard_function-naming = disabled
